          "text": "什么信息？",
          "reviewStatus": "confirmed"
        },
        {
          "messageId": "h25-verify-04",
          "speakerId": "linchen",
          "text": "好的，非常感谢。",
          "reviewStatus": "confirmed"
        }
      ]
    },
    {
